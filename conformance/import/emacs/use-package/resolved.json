{
  "agenda_files": [
    "/fixture/tasks.org"
  ],
  "agenda_span": "week",
  "agenda_start_day": null,
  "capture": [],
  "commands": [
    {
      "blocks": [
        {
          "kind": "agenda"
        },
        {
          "kind": "alltodo"
        }
      ],
      "description": "Agenda and all TODOs",
      "diagnostics": [],
      "enabled": true,
      "key": "n"
    }
  ],
  "deadline_warning_days": 9,
  "default_priority": "B",
  "diagnostics": [
    {
      "key": "org-agenda-files",
      "message": "init.el:3",
      "status": "exact"
    },
    {
      "key": "org-todo-keywords",
      "message": "init.el:5",
      "status": "exact"
    },
    {
      "key": "org-deadline-warning-days",
      "message": "init.el:6",
      "status": "exact"
    },
    {
      "key": "org-log-done",
      "message": "init.el:7",
      "status": "exact"
    },
    {
      "key": "org-capture-templates",
      "message": "not set in these files; Org's default applies",
      "status": "difference"
    },
    {
      "key": "org-agenda-custom-commands",
      "message": "not set in these files; Org's default applies",
      "status": "difference"
    }
  ],
  "editor": "emacs",
  "editor_version": "30.2",
  "highest_priority": "A",
  "log_done": "note",
  "log_into_drawer": false,
  "log_redeadline": "nil",
  "log_repeat": "time",
  "log_reschedule": "nil",
  "lowest_priority": "C",
  "org_directory": null,
  "skip_deadline_if_done": false,
  "skip_scheduled_if_done": false,
  "skip_timestamp_if_done": false,
  "sorting_strategy": [
    "habit-down",
    "time-up",
    "urgency-down",
    "category-keep"
  ],
  "tag_inheritance_exclusions": [],
  "tags_column": -77,
  "todo_sequences": [
    [
      "BACKLOG(b)",
      "DOING(g!)",
      "|",
      "DONE(d@)"
    ]
  ],
  "verification": {},
  "week_start": "monday"
}
