{
  "agenda_files": [
    "/fixture/tasks.org"
  ],
  "agenda_span": "week",
  "agenda_start_day": "-1d",
  "capture": {
    "t": {
      "datetree": false,
      "desc": "Todo",
      "diagnostics": [],
      "enabled": true,
      "file": "/fixture/tasks.org",
      "heading": "Inbox",
      "template": "* TODO %?\n:CREATED: %U"
    },
    "x": {
      "datetree": false,
      "desc": "Dynamic",
      "diagnostics": [
        "dynamic capture target is unsupported",
        "%(sexp) template forms are disabled"
      ],
      "enabled": false,
      "template": "* TODO %(danger)"
    }
  },
  "commands": [
    {
      "blocks": [
        {
          "kind": "tags-todo",
          "match": "+work/TODO|NEXT"
        }
      ],
      "description": "Work",
      "diagnostics": [],
      "enabled": true,
      "key": "w"
    },
    {
      "blocks": [
        {
          "kind": "agenda",
          "span": "day"
        },
        {
          "header": "Home",
          "kind": "tags",
          "match": "home"
        }
      ],
      "description": "Home block",
      "diagnostics": [
        "option org-agenda-files-ignored is not imported"
      ],
      "enabled": true,
      "key": "b"
    },
    {
      "blocks": [
        {
          "kind": "agenda"
        }
      ],
      "description": "Review",
      "diagnostics": [
        "custom command form is unsupported"
      ],
      "enabled": false,
      "key": "r"
    }
  ],
  "deadline_warning_days": 5,
  "default_priority": "C",
  "diagnostics": [],
  "editor": "emacs",
  "editor_version": "30.2",
  "groups": [],
  "highest_priority": "A",
  "log_done": "time",
  "log_into_drawer": true,
  "log_redeadline": "nil",
  "log_repeat": "note",
  "log_reschedule": "nil",
  "lowest_priority": "D",
  "org_version": "9.7.11",
  "persistent_tags": [
    "(\"important\" . 105)"
  ],
  "skip_deadline_if_done": true,
  "skip_scheduled_if_done": true,
  "skip_timestamp_if_done": false,
  "sorting_strategy": [
    "priority-down",
    "time-up",
    "category-keep"
  ],
  "source": "batch-profile",
  "tag_alist": [
    "(\"work\" . 119)",
    "(\"home\" . 104)"
  ],
  "tag_inheritance_exclusions": [
    "noinherit"
  ],
  "tags_column": -77,
  "todo_sequences": [
    [
      "TODO(t)",
      "NEXT(n!)",
      "WAIT(w@)",
      "|",
      "DONE(d!)",
      "CANCELLED(c@)"
    ]
  ],
  "verification": {},
  "week_start": "sunday"
}
