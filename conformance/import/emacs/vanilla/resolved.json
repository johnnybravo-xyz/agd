  "editor": "emacs",
  "editor_version": "30.2",
  "highest_priority": "A",
  "log_done": "time",
  "log_into_drawer": true,
  "log_redeadline": "nil",
  "log_repeat": "note",
  "log_reschedule": "nil",
  "lowest_priority": "D",
  "org_directory": null,
  "skip_deadline_if_done": true,
  "skip_scheduled_if_done": true,
  "skip_timestamp_if_done": false,
  "sorting_strategy": [
    "priority-down",
    "time-up",
    "category-keep"
  ],
  "tag_inheritance_exclusions": [
    "noinherit"
  ],
  "tags_column": -77,
  "todo_sequences": [
    [
      "TODO(t)",
      "NEXT(n!)",
      "WAIT(w@)",
      "|",
      "DONE(d!)",
      "CANCELLED(c@)"
    ]
  ],
  "verification": {},
  "week_start": "sunday"
}
