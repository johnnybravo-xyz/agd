{
  "agenda_files": [
    "/fixture/tasks.org"
  ],
  "agenda_span": "week",
  "agenda_start_day": "-1d",
  "capture": [
    {
      "datetree": false,
      "desc": "Todo",
      "diagnostics": [],
      "enabled": true,
      "file": "/fixture/tasks.org",
      "heading": "Inbox",
      "key": "t",
      "template": "* TODO %?\n:CREATED: %U"
    },
    {
      "datetree": false,
      "desc": "Dynamic",
      "diagnostics": [
        "%(sexp) template forms are disabled",
        "a computed capture target is unsupported"
      ],
      "enabled": false,
      "key": "x",
      "template": "* TODO %(danger)"
    },
    {
      "datetree": false,
      "desc": "Appointment",
      "diagnostics": [],
      "enabled": true,
      "file": "/fixture/tasks.org",
      "key": "a",
      "template": "* %?"
    }
  ],
  "commands": [
    {
      "blocks": [
        {
          "kind": "tags-todo",
          "match": "+work/TODO|NEXT"
        }
      ],
      "description": "Work",
      "diagnostics": [],
      "enabled": true,
      "key": "w"
    },
    {
      "blocks": [
        {
          "kind": "agenda",
          "span": "day"
        },
        {
          "header": "Home",
          "kind": "tags",
          "match": "home"
        }
      ],
      "description": "Home block",
      "diagnostics": [
        "option org-agenda-files-ignored is not imported"
      ],
      "enabled": true,
      "key": "b"
    },
    {
      "blocks": [
        {
          "kind": "agenda"
        }
      ],
      "description": "Review",
      "diagnostics": [
        "custom command form is unsupported"
      ],
      "enabled": false,
      "key": "r"
    }
  ],
  "deadline_warning_days": 5,
  "default_priority": "C",
  "diagnostics": [
    {
      "key": "org-agenda-files",
      "message": "init.el:2",
      "status": "exact"
    },
    {
      "key": "org-todo-keywords",
      "message": "init.el:4",
      "status": "exact"
    },
    {
      "key": "org-tags-exclude-from-inheritance",
      "message": "init.el:8",
      "status": "exact"
    },
    {
