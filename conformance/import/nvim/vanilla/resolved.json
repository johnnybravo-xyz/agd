{
  "agenda_files": [
    "/fixture/tasks.org"
  ],
  "agenda_span": "week",
  "agenda_start_day": "-1d",
  "capture": {
    "t": {
      "desc": "Todo",
      "diagnostics": [],
      "enabled": true,
      "file": "/fixture/tasks.org",
      "template": "* TODO %?"
    },
    "x": {
      "desc": "Dynamic",
      "diagnostics": [
        "dynamic template body is unsupported",
        "dynamic capture target is unsupported"
      ],
      "enabled": false,
      "template": ""
    }
  },
  "commands": [
    {
      "blocks": [
        {
          "header": "Today",
          "kind": "agenda",
          "span": "day"
        },
        {
          "kind": "tags",
          "match": "review"
        }
      ],
      "description": "Review",
      "diagnostics": [],
      "enabled": true,
      "key": "r"
    },
    {
      "blocks": [
        {
          "kind": "tags-todo",
          "match": "+work/TODO|NEXT"
        }
      ],
      "description": "Work",
      "diagnostics": [],
      "enabled": true,
      "key": "w"
    }
  ],
  "deadline_warning_days": 6,
  "default_priority": "C",
  "diagnostics": [],
  "editor": "nvim",
  "editor_version": "0.12.6",
  "groups": [],
  "highest_priority": "A",
  "log_done": "time",
  "log_into_drawer": true,
  "log_redeadline": "nil",
  "log_repeat": "note",
  "log_reschedule": "nil",
  "lowest_priority": "D",
  "org_version": "999.0.0",
  "persistent_tags": [
    "important"
  ],
  "skip_deadline_if_done": true,
  "skip_scheduled_if_done": true,
  "skip_timestamp_if_done": false,
  "sorting_strategy": [
    "priority-down",
    "time-up"
  ],
  "source": "profile",
  "tag_alist": [
    "work",
    "home"
  ],
  "tag_inheritance_exclusions": [
    "noinherit"
  ],
  "tags_column": -80,
  "todo_sequences": [
    [
      "TODO(t)",
      "NEXT(n!)",
      "|",
      "DONE(d!)"
    ]
  ],
  "week_start": "sunday"
}
