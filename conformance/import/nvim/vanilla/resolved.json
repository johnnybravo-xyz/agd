{
  "agenda_files": [
    "/fixture/tasks.org"
  ],
  "agenda_span": "week",
  "agenda_start_day": "-1d",
  "capture": [
    {
      "desc": "Note",
      "diagnostics": [],
      "enabled": true,
      "file": "/fixture/tasks.org",
      "key": "n",
      "template": "* %?"
    },
    {
      "desc": "Todo",
      "diagnostics": [],
      "enabled": true,
      "file": "/fixture/tasks.org",
      "key": "t",
      "template": "* TODO %?"
    },
    {
      "desc": "Dynamic",
      "diagnostics": [
        "a computed capture target is unsupported"
      ],
      "enabled": false,
      "key": "x",
      "template": "* TODO %?"
    }
  ],
  "commands": [
    {
      "blocks": [
        {
          "kind": "tags-todo",
          "match": "TODO=\"NEXT\""
        }
      ],
      "description": "Next",
      "diagnostics": [],
      "enabled": true,
      "key": "n"
    },
    {
      "blocks": [
        {
          "header": "Today",
          "kind": "agenda",
          "span": "day"
        },
        {
          "kind": "tags",
          "match": "review"
        }
      ],
      "description": "Review",
      "diagnostics": [],
      "enabled": true,
      "key": "r"
    },
    {
      "blocks": [
        {
          "kind": "tags-todo",
          "match": "+work/TODO|NEXT"
        }
      ],
      "description": "Work",
      "diagnostics": [],
      "enabled": true,
      "key": "w"
    }
  ],
  "deadline_warning_days": 6,
  "default_priority": "C",
  "diagnostics": [
    {
      "key": "setup",
      "message": "init.lua",
      "status": "exact"
    }
  ],
  "editor": "nvim",
  "highest_priority": "A",
  "log_done": "time",
  "log_into_drawer": true,
  "log_redeadline": "nil",
  "log_repeat": "note",
  "log_reschedule": "nil",
  "lowest_priority": "D",
  "skip_deadline_if_done": true,
  "skip_scheduled_if_done": true,
  "skip_timestamp_if_done": false,
  "sorting_strategy": [
    "priority-down",
    "time-up"
  ],
  "tag_inheritance_exclusions": [
    "noinherit"
  ],
  "tags_column": -80,
  "todo_sequences": [
    [
      "TODO(t)",
      "NEXT(n!)",
      "|",
      "DONE(d!)"
    ]
  ],
  "week_start": "sunday"
}
