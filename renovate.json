{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Keep rowan compatible with orgize's syntax tree",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["rowan"],
      "allowedVersions": "0.15"
    },
    {
      "description": "Keep orgize exactly pinned for source-preserving writes",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["orgize"],
      "rangeStrategy": "pin"
    }
  ]
}
