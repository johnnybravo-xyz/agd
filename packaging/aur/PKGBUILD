# Maintainer: johnnybravo-xyz
pkgname=agd
pkgver=0.3.0
pkgrel=1
pkgdesc="An org-agenda for the terminal and for coding agents"
arch=('x86_64' 'aarch64')
url="https://github.com/johnnybravo-xyz/agd"
license=('GPL-3.0-or-later' 'MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1b1d06c1579cf380a241fb828932ab4c67ef20106f895c1dbe468d4c90d2f9f1')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --package agd
  mkdir -p target/completions
  target/release/agd completions bash > target/completions/agd
  target/release/agd completions zsh > target/completions/_agd
  target/release/agd completions fish > target/completions/agd.fish
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --workspace --all-targets
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/agd "$pkgdir/usr/bin/agd"
  install -Dm644 target/completions/agd "$pkgdir/usr/share/bash-completion/completions/agd"
  install -Dm644 target/completions/_agd "$pkgdir/usr/share/zsh/site-functions/_agd"
  install -Dm644 target/completions/agd.fish "$pkgdir/usr/share/fish/vendor_completions.d/agd.fish"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
}
