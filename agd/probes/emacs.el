(require 'cl-lib)
(require 'json)
(require 'org)
(require 'org-agenda)
(require 'org-capture nil t)

(defvar agendum-import-verify nil)

(defun agendum--string (value)
  (cond ((null value) "nil")
        ((stringp value) value)
        ((symbolp value) (symbol-name value))
        ((characterp value) (char-to-string value))
        (t (format "%S" value))))

(defun agendum--strings (values)
  (vconcat (mapcar #'agendum--string (or values '()))))

(defun agendum--todo-sequences ()
  (vconcat
   (mapcar (lambda (sequence)
             (vconcat (mapcar #'agendum--string (cdr sequence))))
           org-todo-keywords)))

(defun agendum--capture-template (entry)
  (let* ((key (nth 0 entry))
         (description (nth 1 entry))
         (kind (nth 2 entry))
         (target (nth 3 entry))
         (body (nth 4 entry))
         (enabled (eq kind 'entry))
         (diagnostics '())
         (value (make-hash-table :test 'equal)))
    (puthash "desc" description value)
    (puthash "datetree" :json-false value)
    (puthash "enabled" (if enabled t :json-false) value)
    (puthash "diagnostics" [] value)
    (cond
     ((stringp body)
      (puthash "template" body value)
      (when (string-match-p "%[(]" body)
        (setq enabled nil diagnostics '("%(sexp) template forms are disabled"))))
     ((and (listp body) (eq (car body) 'file) (stringp (cadr body)))
      (puthash "template" "" value)
      (puthash "template_file" (expand-file-name (cadr body)) value))
     (t
      (puthash "template" "" value)
      (setq enabled nil diagnostics '("dynamic template body is unsupported"))))
    (cond
     ((and (listp target) (eq (car target) 'file) (stringp (cadr target)))
      (puthash "file" (expand-file-name (cadr target)) value))
     ((and (listp target) (eq (car target) 'file+headline)
           (stringp (cadr target)) (stringp (nth 2 target)))
      (puthash "file" (expand-file-name (cadr target)) value)
      (puthash "heading" (nth 2 target) value))
     ((and (listp target) (eq (car target) 'file+olp) (stringp (cadr target)))
      (puthash "file" (expand-file-name (cadr target)) value)
      (puthash "outline_path" (vconcat (cddr target)) value))
     ((and (listp target) (eq (car target) 'file+datetree) (stringp (cadr target)))
      (puthash "file" (expand-file-name (cadr target)) value)
      (puthash "datetree" t value))
     ((and (listp target) (eq (car target) 'id) (stringp (cadr target)))
      (puthash "id" (cadr target) value))
     (t (setq enabled nil diagnostics
              (cons "dynamic capture target is unsupported" diagnostics))))
    (puthash "enabled" (if enabled t :json-false) value)
    (puthash "diagnostics" (vconcat diagnostics) value)
    (cons key value)))

(defun agendum--captures ()
  (let ((result (make-hash-table :test 'equal)))
    (dolist (entry (or (and (boundp 'org-capture-templates) org-capture-templates) '()))
      (when (and (listp entry) (>= (length entry) 5))
        (let ((normalized (agendum--capture-template entry)))
          (puthash (car normalized) (cdr normalized) result))))
    result))

(defun agendum--contains-function-p (value)
  (cond
   ((functionp value) t)
   ((and (consp value) (eq (car value) 'lambda)) t)
   ((consp value)
    (or (agendum--contains-function-p (car value))
        (agendum--contains-function-p (cdr value))))
   (t nil)))

(defun agendum--portable-command (entry)
  (let* ((key (agendum--string (nth 0 entry)))
         (description (agendum--string (nth 1 entry)))
         (kind-value (nth 2 entry))
         (kind (agendum--string kind-value))
         (supported (and (memq kind-value '(agenda todo tags tags-todo search))
                         (not (agendum--contains-function-p entry))))
         (match-value (nth 3 entry))
         (diagnostics (if supported '() '("custom command form is unsupported"))))
    `((key . ,key)
      (description . ,description)
      (kind . ,kind)
      (match_expression . ,(and (stringp match-value) match-value))
      (enabled . ,(if supported t :json-false))
      (diagnostics . ,(vconcat diagnostics)))))

(defun agendum--commands ()
  (vconcat
   (mapcar #'agendum--portable-command
           (or (and (boundp 'org-agenda-custom-commands)
                    org-agenda-custom-commands)
               '()))))

(defconst agendum--super-agenda-keys
  '(:name :tag :priority :todo :deadline :scheduled :time-grid :and :not :auto-category))

(defun agendum--super-group-supported-p (group)
  (and (boundp 'org-super-agenda-version)
       (string-match-p "\\`1\\." (agendum--string org-super-agenda-version))
       (listp group)
       (not (agendum--contains-function-p group))
       (cl-loop for (key _value) on group by #'cddr
                always (memq key agendum--super-agenda-keys))))

(defun agendum--super-groups ()
  (if (boundp 'org-super-agenda-groups)
      (vconcat
       (mapcar
        (lambda (group)
          (let ((supported (agendum--super-group-supported-p group)))
            `((key . ,(agendum--string (or (plist-get group :name) "group")))
              (description . ,(agendum--string (or (plist-get group :name) "Group")))
              (kind . "org-super-agenda")
              (match_expression . ,(format "%S" group))
              (enabled . ,(if supported t :json-false))
              (diagnostics . ,(if supported []
                                [\"unsupported org-super-agenda version or group form\"])))))
        org-super-agenda-groups))
    []))

(defun agendum--verification-rows ()
  (let ((result (make-hash-table :test 'equal)))
    (when (or agendum-import-verify
              (equal (getenv "AGENDUM_IMPORT_VERIFY") "1"))
      (puthash "a" (with-output-to-string (org-batch-agenda-csv "a")) result)
      (dolist (entry (or (and (boundp 'org-agenda-custom-commands)
                              org-agenda-custom-commands)
                         '()))
        (when (and (listp entry)
                   (stringp (car entry))
                   (memq (nth 2 entry) '(agenda todo tags tags-todo search))
                   (not (agendum--contains-function-p entry)))
          (condition-case error
              (puthash (car entry)
                       (with-output-to-string
                         (org-batch-agenda-csv (car entry)))
                       result)
            (error
             (puthash (car entry)
                      (format "AGENDUM_VERIFY_ERROR:%s"
                              (error-message-string error))
                      result))))))
    result))

(defun agendum-import-probe ()
  (let ((capture (agendum--captures)))
    (json-encode
     `((editor . "emacs")
       (editor_version . ,emacs-version)
       (org_version . ,(org-version))
       (source . ,(or (getenv "AGENDUM_IMPORT_SOURCE") "daemon"))
       (agenda_files . ,(vconcat (org-agenda-files t)))
       (todo_sequences . ,(agendum--todo-sequences))
       (tag_alist . ,(agendum--strings org-tag-alist))
       (persistent_tags . ,(agendum--strings org-tag-persistent-alist))
       (tag_inheritance_exclusions . ,(agendum--strings org-tags-exclude-from-inheritance))
       (highest_priority . ,(char-to-string org-highest-priority))
       (lowest_priority . ,(char-to-string org-lowest-priority))
       (default_priority . ,(char-to-string org-default-priority))
       (deadline_warning_days . ,org-deadline-warning-days)
       (agenda_span . ,(agendum--string org-agenda-span))
       (agenda_start_day . ,org-agenda-start-day)
       (week_start . ,(if (= org-agenda-start-on-weekday 0) "sunday" "monday"))
       (skip_scheduled_if_done . ,(if org-agenda-skip-scheduled-if-done t :json-false))
       (skip_deadline_if_done . ,(if org-agenda-skip-deadline-if-done t :json-false))
       (skip_timestamp_if_done . ,(if org-agenda-skip-timestamp-if-done t :json-false))
       (sorting_strategy . ,(agendum--strings org-agenda-sorting-strategy))
       (time_grid . ,(agendum--strings org-agenda-time-grid))
       (log_done . ,(agendum--string org-log-done))
       (log_repeat . ,(agendum--string org-log-repeat))
       (log_into_drawer . ,(if org-log-into-drawer t :json-false))
       (capture . ,capture)
       (groups . ,(agendum--super-groups))
       (commands . ,(agendum--commands))
       (verification . ,(agendum--verification-rows))
       (diagnostics . [])))))

(when (equal (getenv "AGENDUM_PROBE_STDOUT") "1")
  (princ "AGENDUM_JSON:")
  (princ (agendum-import-probe))
  (terpri))
